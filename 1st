#include <iostream>
using namespace std;


bool isugly(int a){
    if (a <= 0){
        return false;
    }
    
    while (a % 2 == 0){
        a /= 2;
    }
    
    while (a % 3 == 0){
        a /= 3;
    }
    
    while (a % 5 == 0){
        a /= 5;
    }
    
    return a == 1;
}

int main(){
    int a;
    cin >> a;
    
    cout << (isugly(a) ? "true" : "false") << endl;
    return 0;
}
