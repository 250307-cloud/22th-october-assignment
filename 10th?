#include <iostream>
using namespace std;


void printrow(int start, int count){
    for (int i = 0; i < count; i++){
        if (i > 0){
            cout << " ";
        }
        
        cout << start + i;
    }
    
    cout << endl;
}

int main(){
    int n;
    cin >> n;
    
    int start = 1;
    
    for (int row = 1; row <= n; row++){
        printrow(start, row);
        start += row;
    }
    
    return 0;
}

