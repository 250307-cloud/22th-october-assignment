#include <iostream>
using namespace std;


int digitproduct(int n){
    if (n == 0){
        return 0;
    }
    
    int product = 1;
    
    while (n > 0){
        int digit = n % 10;
        product *= digit;
        n /= 10;
    }
    
    return product;
}

int main(){
    int n;
    cin >> n;
    
    cout << digitproduct(n) << endl;
    return 0;
}
